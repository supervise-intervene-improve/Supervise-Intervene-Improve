import numpy as np

def _get_cam_pos_R(data, cam_id: int):
    # cam position
    cam_xpos = np.asarray(data.cam_xpos)
    if cam_xpos.ndim == 2:
        pos = cam_xpos[cam_id]
    else:
        pos = cam_xpos[cam_id*3:(cam_id+1)*3]

    # cam rotation (9 floats)
    cam_xmat = np.asarray(data.cam_xmat)
    if cam_xmat.ndim == 2:
        # shape: (ncam, 9)
        xmat9 = cam_xmat[cam_id]
    else:
        # shape: (ncam*9,)
        xmat9 = cam_xmat[cam_id*9:(cam_id+1)*9]

    xmat9 = np.asarray(xmat9).reshape(9,)
    R = xmat9.reshape(3, 3)
    return pos, R



def mujoco_to_unity_xyz(p_mj: np.ndarray) -> np.ndarray:
    """
    Mapping user mentioned: (-y, z, x)
    p_mj Nx3 -> p_unity Nx3
    """
    return np.stack([-p_mj[:, 1], p_mj[:, 2], p_mj[:, 0]], axis=1).astype(np.float32)

def depth_to_pointcloud_xyzrgb(depth_m, rgb_u8, w, h, fovy_deg, stride=4, min_depth=0.02, max_depth=None, flip_y=False, flip_x=False):
    fovy = np.deg2rad(fovy_deg)
    fy = 0.5 * h / np.tan(0.5 * fovy)
    fx = fy
    cx, cy = (w - 1) / 2.0, (h - 1) / 2.0

    yy, xx = np.mgrid[0:h:stride, 0:w:stride]
    z = depth_m[yy, xx]
    valid = (z > float(min_depth)) & np.isfinite(z)
    if max_depth is not None:
        valid &= (z < float(max_depth))

    x = (xx - cx) * z / fx
    y = (yy - cy) * z / fy
    if flip_x:
        x = -x
    if flip_y:
        y = -y

    xyz = np.stack([x, y, z], axis=-1)[valid].reshape(-1, 3).astype(np.float32)
    rgb = rgb_u8[yy, xx, :][valid].reshape(-1, 3).astype(np.uint8)
    return xyz, rgb


def pack_pointcloud_xyzrgba16(xyz_f32, rgb_u8):
    n = xyz_f32.shape[0]
    dtype = np.dtype([
        ("x", "<f4"), ("y", "<f4"), ("z", "<f4"),
        ("r", "u1"), ("g", "u1"), ("b", "u1"), ("a", "u1"),
    ])
    out = np.empty(n, dtype=dtype)
    out["x"] = xyz_f32[:, 0]
    out["y"] = xyz_f32[:, 1]
    out["z"] = xyz_f32[:, 2]
    out["r"] = rgb_u8[:, 0]
    out["g"] = rgb_u8[:, 1]
    out["b"] = rgb_u8[:, 2]
    out["a"] = 255
    return out.tobytes()

