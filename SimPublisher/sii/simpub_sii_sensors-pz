import numpy as np

def _jsonable(x):
    if isinstance(x, (bytes, bytearray)):
        # DO NOT embed big bytes in JSON; store small signature instead
        return {"_type": "bytes", "len": len(x)}
    if isinstance(x, np.generic):
        return x.item()
    if isinstance(x, np.ndarray):
        return x.tolist()
    return x

def sanitize_meta(meta: dict) -> dict:
    out = {}
    for k, v in meta.items():
        out[k] = _jsonable(v)
    return out

def pc7_payload(xyz_world_unity: np.ndarray, rgb_u8: np.ndarray, size=0.01):
    xyz = xyz_world_unity.astype(np.float32)
    rgb = (rgb_u8.astype(np.float32) / 255.0)
    s   = np.full((xyz.shape[0], 1), float(size), dtype=np.float32)
    pc7 = np.concatenate([xyz, rgb, s], axis=1).astype(np.float32)  # (N,7)
    return pc7.tobytes(order="C")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--xml", required=True)
    ap.add_argument("--bind_ip", default="0.0.0.0")
    ap.add_argument("--host_ip", default="127.0.0.1", help="IP announced to Unity via discovery")
    ap.add_argument("--fps", type=int, default=30)
    ap.add_argument("--w", type=int, default=640)
    ap.add_argument("--h", type=int, default=480)
    ap.add_argument("--cams", nargs="*", default=None)
    ap.add_argument("--pc", action="store_true")
    ap.add_argument("--pc_stride", type=int, default=4)
    ap.add_argument("--pc_cams", nargs="*", default=None,
                    help="Camera names to publish point clouds for (default: top)")
    ap.add_argument("--pc_no_flip_z", action="store_true",
                    help="Disable Z flip before cam_to_world (advanced; default is to flip)")
    ap.add_argument("--pc_flip_z", action="store_true",
                    help=argparse.SUPPRESS)  # backward compat
    ap.add_argument("--pc_min_depth", type=float, default=0.02,
                    help="Min depth (m) for point clouds (filters near-plane noise)")
    ap.add_argument("--pc_max_depth", type=float, default=None,
                    help="Max depth (m) for point clouds (defaults to zfar*0.95)")
    ap.add_argument("--pc_flip_y", action="store_true",
                    help="Flip Y axis in camera frame (use if cloud appears mirrored vertically)")
    ap.add_argument("--pc_flip_x", action="store_true",
                    help="Flip X axis in camera frame (use if cloud appears mirrored horizontally)")
    args = ap.parse_args()
    
    global HOST_IP
    HOST_IP = args.host_ip
    model = mujoco.MjModel.from_xml_path(args.xml)
    data  = mujoco.MjData(model)

    cams = args.cams if args.cams else list_cameras(model)
    if not cams:
        raise RuntimeError("No cameras found in XML")

    pc_max_depth = args.pc_max_depth
    if pc_max_depth is None:
        pc_max_depth = float(model.vis.map.zfar) * 0.95

    topic_prefix = "SimPub/Sensors"
    topic_list = [f"{topic_prefix}/{cam}/rgbd" for cam in cams]
    pc_cams = None
    if args.pc:
        pc_cams = args.pc_cams if args.pc_cams else ["top"]
        topic_list += [f"{topic_prefix}/{cam}/pc" for cam in pc_cams]

    node_info = {
        "name": "SimPub",
        "type": "SimPub",
        "nodeInfoID": NODE_INFO_ID,
        "ip": args.host_ip,
        "servicePort": SERVICE_PORT,
        "topicPort": TOPIC_PORT,
        "serviceList": [],
        "topicList": topic_list,
    }


    print("[SimPub] XML:", args.xml)
    print("[SimPub] Cams:", cams)
    print("[SimPub] Publishing topics:", topic_prefix + "/<cam>/rgbd")
    flip_z = (not args.pc_no_flip_z) or args.pc_flip_z
    if args.pc:
        print("[SimPub] PC cams:", args.pc_cams if args.pc_cams else ["top"])
        print(f"[SimPub] PC depth range: {args.pc_min_depth} .. {pc_max_depth}")
        print(f"[SimPub] PC flip Z: {flip_z}")
        print(f"[SimPub] PC flip Y: {args.pc_flip_y}")
        print(f"[SimPub] PC flip X: {args.pc_flip_x}")
    print("[SimPub] Service:", f"tcp://{args.bind_ip}:{SERVICE_PORT}")
    print("[SimPub] Topic  :", f"tcp://{args.bind_ip}:{TOPIC_PORT}")
    print("[SimPub] Discovery broadcast on UDP", DISCOVERY_PORT)

    stop_evt = threading.Event()

    # ZMQ
    zctx = zmq.Context.instance()

    # Start discovery + REP service
    t_disc = threading.Thread(target=discovery_broadcast_loop, args=(args.host_ip, stop_evt), daemon=True)
    t_rep = threading.Thread(target=service_rep_loop,args=(zctx, args.bind_ip, stop_evt, cams, pc_cams),daemon=True)

    t_disc.start()
    t_rep.start()

    # PUB socket
    pub = zctx.socket(zmq.PUB)
    pub.bind(f"tcp://{args.bind_ip}:{TOPIC_PORT}")



    # Renderer
    renderer = GLFWMjrRenderer(model, args.w, args.h)
  
    #renderer = mujoco.Renderer(model, args.w, args.h)

    dt = 1.0 / float(args.fps)
    frame_idx = 0
    try:
        while True:
            t0 = time.time()
            mujoco.mj_step(model, data)

            for cam_name in cams:
                rgb, depth_m = renderer.render(data, cam_name)
                rgb_jpg = encode_rgb_jpg(rgb)

                cam_id = model.camera(cam_name).id
                fovy = float(model.cam_fovy[cam_id])

                # ----- POINTCLOUD (selectable cams) -----
                pc_cams = args.pc_cams if args.pc_cams else ["top"]
                if args.pc and cam_name in pc_cams:
                    xyz_cam, rgb_pc = depth_to_pointcloud_xyzrgb(
                        depth_m, rgb, args.w, args.h, fovy,
                        stride=args.pc_stride,
                        min_depth=args.pc_min_depth,
                        max_depth=pc_max_depth,
                        flip_y=args.pc_flip_y,
                        flip_x=args.pc_flip_x,
                    )
                    if flip_z:
                        xyz_cam[:, 2] *= -1.0
                    xyz_world_mj = cam_to_world(model=model, data=data, cam_name=cam_name, pts_cam_mj=xyz_cam)
                    xyz_world_unity = mujoco_to_unity_xyz(xyz_world_mj)

                    pc_payload = pc7_payload(xyz_world_unity, rgb_pc, size=0.02)

                    pc_topic = f"SimPub/Sensors/{cam_name}/pc".encode("utf-8")
                    pub.send_multipart([pc_topic, pc_payload])

                    if frame_idx % 60 == 0 and xyz_world_unity.shape[0] > 0:
                        mn = xyz_world_unity.min(axis=0); mx = xyz_world_unity.max(axis=0)
                        print(f"[PC] {cam_name} N={xyz_world_unity.shape[0]} bbox min={mn} max={mx} bytes={len(pc_payload)}")

                # --- RGBD blob: publish ONCE for THIS cam_name ---
                meta = {
                    "cam": cam_name,
                    "w": int(args.w),
                    "h": int(args.h),
                    "fovy": fovy,
                    # anything else you already include...
                }
                #meta = sanitize_meta(meta)
                #json_ = json.dumps(meta, separators=(",", ":")).encode("utf-8")

                #blob = build_rgbd_blob(rgb_jpg, depth_m, meta, pc=np.zeros((0, 3), np.float32))
                # pts_cam_mj computed from depth
                pts_cam, _rgb_dummy = depth_to_pointcloud_xyzrgb(
                    depth_m, rgb, args.w, args.h, fovy,
                    stride=args.pc_stride,
                    min_depth=args.pc_min_depth,
                    max_depth=pc_max_depth,
                    flip_y=args.pc_flip_y,
                    flip_x=args.pc_flip_x,
                )
                if flip_z:
                    pts_cam[:, 2] *= -1.0
                pts_world = cam_to_world(model=model, data=data, cam_name=cam_name, pts_cam_mj=pts_cam)

                # Only attach PC in the RGBD blob for "top" to reduce load
                pc_for_blob = mujoco_to_unity_xyz(pts_world) if (args.pc and cam_name in pc_cams) else np.zeros((0, 3), np.float32)

                blob = build_rgbd_blob(
                    rgb_jpg=rgb_jpg,
                    depth_m=depth_m,
                    meta=meta,
                    pc=pc_for_blob,
                )


                rgbd_topic = f"SimPub/Sensors/{cam_name}/rgbd".encode("utf-8")
                pub.send_multipart([rgbd_topic, blob])
                if frame_idx % 60 == 0:
                    if pts_world.shape[0] > 0:
                        print(cam_name, "pc N=", pts_world.shape[0], "xyz min/max", pts_world.min(axis=0), pts_world.max(axis=0))
                    else:
                        print(cam_name, "pc N=0 (no valid points after depth filter)")





            elapsed = time.time() - t0
            time.sleep(max(0.0, dt - elapsed))
            frame_idx += 1

    except KeyboardInterrupt:
        print("\n[SimPub] Stopping...")
    finally:
        stop_evt.set()
        time.sleep(0.2)
        try:
            renderer.close()
        except Exception:
            pass
        pub.close(0)
        zctx.term()


if __name__ == "__main__":
    main()
