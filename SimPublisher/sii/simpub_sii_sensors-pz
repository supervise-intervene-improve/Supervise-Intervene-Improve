# ---------------- GLFW + MJR offscreen renderer ----------------
# ---------------- GLFW + MJR offscreen renderer ----------------
class GLFWMjrRenderer:
    """
    Windows-safe:
      - Create hidden GLFW window -> valid OpenGL context
      - Configure MuJoCo offscreen buffer size BEFORE creating MjrContext
      - Use MuJoCo mjr_context + mjr_readPixels for RGB + depth

    Important robustness on Windows:
      - First try COMPAT/ANY profile
      - If MuJoCo still fails, retry with explicit 3.3 CORE profile
    """

    def __init__(self, model: mujoco.MjModel, width: int, height: int):
        self.model = model
        self.width = int(width)
        self.height = int(height)

        if not glfw.init():
            raise RuntimeError("glfw.init() failed")

        def _create_glfw_window():
            # Reset all hints (GLFW keeps them global across calls)
            glfw.default_window_hints()

            # Hidden tiny window; we only need its GL context.
            glfw.window_hint(glfw.VISIBLE, glfw.FALSE)
            glfw.window_hint(glfw.DOUBLEBUFFER, glfw.FALSE)
            glfw.window_hint(glfw.DEPTH_BITS, 24)

            # IMPORTANT:
            # Do NOT set OPENGL_PROFILE at all.
            # Request a legacy/compat context where GL_EXTENSIONS string is valid.
            glfw.window_hint(glfw.CONTEXT_VERSION_MAJOR, 2)
            glfw.window_hint(glfw.CONTEXT_VERSION_MINOR, 1)

            # Also do NOT set FORWARD_COMPAT
            # glfw.window_hint(glfw.OPENGL_FORWARD_COMPAT, glfw.FALSE)  # optional

            win = glfw.create_window(32, 32, "mujoco_offscreen", None, None)
            if not win:
                return None

            glfw.make_context_current(win)
            glfw.swap_interval(0)

            # Print actual context + quick FBO extension visibility check
            try:
                from OpenGL import GL
                v = GL.glGetString(GL.GL_VERSION)
                r = GL.glGetString(GL.GL_RENDERER)
                ven = GL.glGetString(GL.GL_VENDOR)
                exts = GL.glGetString(GL.GL_EXTENSIONS)
                print(f"[SimPub] GL context: {v.decode(errors='ignore')} | "
                    f"{r.decode(errors='ignore')} | {ven.decode(errors='ignore')}")
                if exts:
                    exts_s = exts.decode(errors="ignore")
                    print(f"[SimPub] Has ARB_framebuffer_object: {'ARB_framebuffer_object' in exts_s}")
                else:
                    print("[SimPub] GL_EXTENSIONS string unavailable")
            except Exception:
                pass

            return win

        # Attempt 1: Compatibility / Any profile
        self._win = _create_glfw_window()
        if not self._win:
            glfw.terminate()
            raise RuntimeError("glfw.create_window failed")

        # Ensure we really have a current context before touching MuJoCo GL
        if glfw.get_current_context() is None:
            glfw.destroy_window(self._win)
            glfw.terminate()
            raise RuntimeError("No current OpenGL context after glfw.make_context_current")

        # Scene + camera + options
        self.scene = mujoco.MjvScene(self.model, maxgeom=10000)
        self.cam = mujoco.MjvCamera()
        self.opt = mujoco.MjvOption()
        mujoco.mjv_defaultCamera(self.cam)
        mujoco.mjv_defaultOption(self.opt)

        # CRITICAL: Configure MuJoCo offscreen FBO size BEFORE creating MjrContext.
        # Otherwise MuJoCo may allocate FBOs with unexpected defaults and fail checks.
        self.model.vis.global_.offwidth = self.width
        self.model.vis.global_.offheight = self.height
        self.model.vis.quality.offsamples = 0  # keep MSAA off unless you need it
        
        self.con = mujoco.MjrContext(self.model, mujoco.mjtFontScale.mjFONTSCALE_150)
        # Force rendering into the offscreen buffer sized above.
        try:
            mujoco.mjr_setBuffer(mujoco.mjtFramebuffer.mjFB_OFFSCREEN, self.con)
        except Exception as e:
            print(f"[SimPub][WARN] mjr_setBuffer(mjFB_OFFSCREEN) failed: {e}")


        # Viewport & buffers
        self.viewport = mujoco.MjrRect(0, 0, self.width, self.height)
        self.rgb = np.zeros((self.height, self.width, 3), dtype=np.uint8)
        self.depth = np.zeros((self.height, self.width), dtype=np.float32)

    def close(self):
        try:
            glfw.make_context_current(self._win)
        except Exception:
            pass
        try:
            glfw.destroy_window(self._win)
        except Exception:
            pass
        glfw.terminate()

    def render(self, data: mujoco.MjData, cam_name: str):
        # Always ensure our context is current on this thread
        glfw.make_context_current(self._win)

        cam_id = mujoco.mj_name2id(self.model, mujoco.mjtObj.mjOBJ_CAMERA, cam_name)
        if cam_id < 0:
            raise RuntimeError(f"Camera not found: {cam_name}")

        self.cam.type = mujoco.mjtCamera.mjCAMERA_FIXED
        self.cam.fixedcamid = cam_id

        mujoco.mjv_updateScene(
            self.model, data, self.opt, None, self.cam,
            mujoco.mjtCatBit.mjCAT_ALL, self.scene
        )
        mujoco.mjr_render(self.viewport, self.scene, self.con)
        mujoco.mjr_readPixels(self.rgb, self.depth, self.viewport, self.con)

        depth_m = depth_buffer_to_meters(self.model, self.depth)
        return self.rgb.copy(), depth_m.astype(np.float32)


def depth_buffer_to_meters(model: mujoco.MjModel, depth_buf: np.ndarray) -> np.ndarray:
    """
    mjr_readPixels returns depth buffer values in [0,1] (OpenGL).
    Convert to linear depth in meters using near/far from model.vis.map.
    """
    # MuJoCo uses these for rendering depth
    znear = float(model.vis.map.znear)
    zfar  = float(model.vis.map.zfar)

    d = np.clip(depth_buf, 1e-6, 1.0 - 1e-6).astype(np.float32)
    # OpenGL depth -> linear depth
    # z = (2*n*f) / (f + n - (2*d - 1)*(f - n))
    z = (2.0 * znear * zfar) / (zfar + znear - (2.0 * d - 1.0) * (zfar - znear))
    return z


def depth_to_pointcloud(depth_m: np.ndarray, fovy_deg: float, stride: int = 4) -> np.ndarray:
    H, W = depth_m.shape
    fovy = np.deg2rad(float(fovy_deg))
    fy = (H / 2.0) / np.tan(fovy / 2.0)
    fx = fy
    cx = (W - 1) / 2.0
    cy = (H - 1) / 2.0

    ys = np.arange(0, H, stride)
    xs = np.arange(0, W, stride)
    xx, yy = np.meshgrid(xs, ys)
    z = depth_m[yy, xx]

    valid = np.isfinite(z) & (z > 0)
    xx = xx[valid].astype(np.float32)
    yy = yy[valid].astype(np.float32)
    z  = z[valid].astype(np.float32)

    x = (xx - cx) * z / fx
    y = (yy - cy) * z / fy
    return np.stack([x, y, z], axis=1).astype(np.float32)

def depth_to_pointcloud7(depth_m, rgb, fovy_deg, stride=4, point_size=0.01):
    h, w = depth_m.shape
    yy, xx = np.mgrid[0:h:stride, 0:w:stride].astype(np.float32)
    z = depth_m[0:h:stride, 0:w:stride].astype(np.float32)

    mask = np.isfinite(z) & (z > 0.0)
    xx = xx[mask]; yy = yy[mask]; z = z[mask]

    if z.size == 0:
        return np.zeros((0, 7), dtype=np.float32)

    fovy = np.deg2rad(float(fovy_deg))
    fy = (h / 2.0) / np.tan(fovy / 2.0)
    fx = fy
    cx = (w - 1) / 2.0
    cy = (h - 1) / 2.0

    x = (xx - cx) * z / fx
    y = (yy - cy) * z / fy

    # Sample RGB at the same pixels
    rgb_s = rgb[0:h:stride, 0:w:stride, :].astype(np.float32) / 255.0
    c = rgb_s.reshape(-1, 3)[mask.reshape(-1)]

    size = np.full((z.shape[0], 1), float(point_size), dtype=np.float32)

    pc7 = np.concatenate([x[:, None], y[:, None], z[:, None], c, size], axis=1).astype(np.float32)
    return pc7

def pack_pointcloud_xyzrgbsize(xyz_unity_f32, rgb_u8=None, size=0.01):
    import numpy as np
    xyz = np.asarray(xyz_unity_f32, dtype=np.float32)
    n = xyz.shape[0]
    if rgb_u8 is None:
        rgb = np.ones((n, 3), dtype=np.float32)
    else:
        rgb = (np.asarray(rgb_u8, dtype=np.float32) / 255.0).reshape(n, 3)
    s = np.full((n, 1), float(size), dtype=np.float32)
    pts = np.concatenate([xyz, rgb, s], axis=1)  # (N,7)
    return pts.tobytes()




# ---------------- IRXR Master (UDP discovery + REP service) ----------------
MULTICAST_GRP = "239.255.10.10"
DISCOVERY_PORT = 7720

def discovery_broadcast_loop(host_ip: str, stop_evt: threading.Event):
    # EXACT FORMAT REQUIRED BY XRNodeManager:
    # [36 chars node_id][36 chars nodeInfoID][service_port as ascii]
    msg = f"{NODE_ID}{NODE_INFO_ID}{SERVICE_PORT}".encode("utf-8")

    print("[SimPub] Discovery raw:", msg.decode("utf-8"))
    print(f"[SimPub] node_id={NODE_ID} nodeInfoID={NODE_INFO_ID} servicePort={SERVICE_PORT}")

    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 1)

    # Force multicast out of the correct NIC (Windows can throw WinError 10049)
    try:
        sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF, socket.inet_aton(host_ip))
    except OSError as e:
        print(f"[SimPub][WARN] Could not set IP_MULTICAST_IF to {host_ip}: {e}. "
              f"Continuing without forcing NIC.")
    while not stop_evt.is_set():
        sock.sendto(msg, (MULTICAST_GRP, DISCOVERY_PORT))
        time.sleep(0.5)

    sock.close()

def service_rep_loop(zctx: zmq.Context, bind_ip: str, stop_evt: threading.Event, cams: list, pc_cams):
    rep = zctx.socket(zmq.REP)
    rep.bind(f"tcp://{bind_ip}:{SERVICE_PORT}")
    print(f"[SimPub][REP] Listening on tcp://{bind_ip}:{SERVICE_PORT}")

    # Build once; keep it a dict (NOT a JSON string)
    topic_list = [f"SimPub/Sensors/{cam}/rgbd" for cam in cams]
    if pc_cams:
        topic_list += [f"SimPub/Sensors/{cam}/pc" for cam in pc_cams]

    node_info = {
        "name": "SimPub",
        "type": "SimPub",
        "nodeInfoID": NODE_INFO_ID,
        "servicePort": SERVICE_PORT,
        "topicPort": TOPIC_PORT,
        "serviceList": [],
        # IMPORTANT: list the topics you actually publish (even if Unity subscribes to "")
        "topicList": topic_list,  # change if your real topics differ
        "ip": HOST_IP,  # set this global from args.host_ip in main, see note below
        "port": 0,      # some code expects 'port' to exist (even if unused)
    }

    while not stop_evt.is_set():
        try:
            if rep.poll(50) == 0:
                continue

            parts = rep.recv_multipart()
            if not parts:
                continue

            # Handle both styles:
            # 1) single frame: b"GetNodeInfo|..."
            # 2) multipart: [b"GetNodeInfo", b"..."]
            if len(parts) == 1:
                raw = parts[0]
                if SEPARATOR in raw:
                    svc_b, _payload = raw.split(SEPARATOR, 1)
                else:
                    svc_b = raw
            else:
                svc_b = parts[0]

            service = svc_b.decode("utf-8", errors="ignore").strip()
            # Debug
            # print(f"[SimPub][REP] recv: {service} (parts={len(parts)})")

            if service in ("GetNodeInfo", "GetMasterInfo"):
                # SINGLE FRAME, PURE JSON OBJECT BYTES
                rep.send(json.dumps(node_info, separators=(",", ":")).encode("utf-8"))
            else:
                rep.send(REP_SUCCESS)

        except zmq.error.ZMQError:
            break
        except Exception:
            try:
                rep.send(REP_SUCCESS)
            except Exception:
                pass

    rep.close(0)

# ---------------- Topic packet format ----------------
# Packet layout (little-endian):
# 4s   magic "SIIB"
# B    version=1
# H    cam_name_len
# ...  cam_name utf8
# H    width
# H    height
# f    fovy_deg
# I    rgb_size
# I    depth_size
# I    pc_points
# ...  rgb_jpeg bytes
# ...  depth float32 bytes
# ...  pc float32 bytes (pc_points*3)

MAGIC = b"SIIB"
VERSION = 1


def pack_sensor_packet(cam_name: str, w: int, h: int, fovy_deg: float,
                       rgb_jpeg: bytes, depth_m: np.ndarray, pc: np.ndarray) -> bytes:
    cam_b = cam_name.encode("utf-8")
    depth_bytes = depth_m.astype(np.float32).tobytes()
    pc_bytes = pc.astype(np.float32).tobytes() if pc is not None and pc.shape[0] > 0 else b""
    pc_n = int(pc.shape[0]) if pc is not None else 0

    header = struct.pack(
        "<4sBH", MAGIC, VERSION, len(cam_b)
    ) + cam_b + struct.pack(
        "<HHfIII",
        int(w), int(h), float(fovy_deg),
        int(len(rgb_jpeg)), int(len(depth_bytes)), int(pc_n)
    )

    return header + rgb_jpeg + depth_bytes + pc_bytes
def encode_rgb_jpg(rgb_u8: np.ndarray, quality=80) -> bytes:
    import cv2
    ok, buf = cv2.imencode(".jpg", rgb_u8[:, :, ::-1], [int(cv2.IMWRITE_JPEG_QUALITY), int(quality)])
    if not ok:
        raise RuntimeError("cv2.imencode failed")
    return buf.tobytes()

def pack_rgbd_blob(cam_name: str, w: int, h: int, fovy_deg: float, timestamp: float,
                   rgb_jpg: bytes, depth_f32: np.ndarray) -> bytes:
    depth_bytes = depth_f32.astype(np.float32).tobytes()

    header = {
        "cam_name": cam_name,
        "width": int(w),
        "height": int(h),
        "fovy_deg": float(fovy_deg),
        "timestamp": float(timestamp),
        "rgb_format": "jpg",
        "depth_format": "f32",
        "rgb_len": len(rgb_jpg),
        "depth_len": len(depth_bytes),
        
    }
    header_bytes = json.dumps(header).encode("utf-8")

    out = bytearray()
    out += struct.pack("<I", len(header_bytes))
    out += header_bytes
    out += struct.pack("<I", len(rgb_jpg))
    out += rgb_jpg
    out += struct.pack("<I", len(depth_bytes))
    out += depth_bytes
    return bytes(out)

def depth_rgb_to_pointcloud7(depth_f32: np.ndarray, rgb_u8: np.ndarray, fovy_deg: float,
                             stride: int = 4, size: float = 0.01) -> np.ndarray:
    """
    Returns Nx7 float32: x,y,z,r,g,b,size in CAMERA frame.
    """
    h, w = depth_f32.shape
    fovy = np.deg2rad(fovy_deg)
    fy = (h * 0.5) / np.tan(fovy * 0.5)
    fx = fy  # assume square pixels
    cx = (w - 1) * 0.5
    cy = (h - 1) * 0.5

    us = np.arange(0, w, stride)
    vs = np.arange(0, h, stride)
    uu, vv = np.meshgrid(us, vs)
    z = depth_f32[vv, uu]

    # Filter invalid depths
    valid = np.isfinite(z) & (z > 1e-6)
    uu = uu[valid].astype(np.float32)
    vv = vv[valid].astype(np.float32)
    z  = z[valid].astype(np.float32)

    x = (uu - cx) / fx * z
    y = (vv - cy) / fy * z   # NOTE: image v grows down; this is camera coords

    # colors
    c = rgb_u8[vv.astype(np.int32), uu.astype(np.int32), :].astype(np.float32) / 255.0
    r = c[:, 0]
    g = c[:, 1]
    b = c[:, 2]

    sz = np.full_like(z, float(size), dtype=np.float32)

    pc7 = np.stack([x, y, z, r, g, b, sz], axis=1).astype(np.float32)
    return pc7

import numpy as np

def cam_to_world(*, model, data, cam_name: str, pts_cam_mj):
    import numpy as np
    import mujoco

    cam_id = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_CAMERA, cam_name)

    cam_pos = np.asarray(data.cam_xpos[cam_id], dtype=np.float32)           # (3,)
    cam_xmat_9 = np.asarray(data.cam_xmat[cam_id], dtype=np.float32).reshape(-1)

    if cam_xmat_9.size != 9:
        raise ValueError(f"Expected 9 floats for cam_xmat, got {cam_xmat_9.size}. "
                         f"Cam '{cam_name}' id={cam_id}.")

    R = cam_xmat_9.reshape(3, 3)  # camera orientation matrix from MuJoCo

    pts = np.asarray(pts_cam_mj, dtype=np.float32)
    if pts.ndim == 1:
        pts = pts.reshape(-1, 3)

    # If your camera-frame points use +Z forward but MuJoCo camera uses -Z forward,
    # you may need: pts[:, 2] *= -1.0  (only if your cloud looks mirrored/backwards)
    #
    # MuJoCo cam_xmat is the camera orientation in world coordinates.
    # With row-vector points, use R.T to map camera->world.
    return (pts @ R.T) + cam_pos



