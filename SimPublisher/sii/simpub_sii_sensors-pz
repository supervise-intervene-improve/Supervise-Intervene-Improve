SEPARATOR = b"|"

def combine_header_with_message(topic: str, payload: bytes) -> bytes:
    # matches irxr_sensor_publisher.py
    return topic.encode("utf-8") + SEPARATOR + payload

def _json_default(o):
    # keep meta JSON-safe without changing binary payload layout
    import numpy as np
    if isinstance(o, (bytes, bytearray)):
        # DO NOT embed giant binary blobs into JSON; just represent small bytes safely
        return o.hex()
    if isinstance(o, np.ndarray):
        return o.tolist()
    if isinstance(o, (np.integer, np.floating)):
        return o.item()
    raise TypeError(f"{type(o)} not JSON serializable")




def build_rgbd_blob(*, rgb_jpg: bytes, depth_m, meta: dict, pc=None) -> bytes:
    import json, struct
    import numpy as np

    if not isinstance(meta, dict):
        raise TypeError(f"meta must be dict, got {type(meta)}. "
                        f"This usually means you passed args in the wrong order.")

    # Ensure meta is JSON-serializable (numpy -> python)
    clean = {}
    for k, v in meta.items():
        if isinstance(v, (np.integer,)):
            clean[k] = int(v)
        elif isinstance(v, (np.floating,)):
            clean[k] = float(v)
        elif isinstance(v, np.ndarray):
            clean[k] = v.tolist()
        else:
            clean[k] = v

    json_bytes = json.dumps(clean, separators=(",", ":")).encode("utf-8")

    if pc is None:
        pc = np.zeros((0, 7), dtype=np.float32)
    pc = np.asarray(pc, dtype=np.float32)

    # depth_m must be float32 HxW
    depth_m = np.asarray(depth_m, dtype=np.float32)

    # Blob format (match your Unity decoder):
    # [uint32 json_len][json][uint32 jpg_len][jpg][uint32 depth_len_bytes][depth_f32_bytes][uint32 pc_len_bytes][pc_f32_bytes]
    depth_bytes = depth_m.tobytes(order="C")
    pc_bytes = pc.tobytes(order="C")

    out = bytearray()
    out += struct.pack("<I", len(json_bytes)) + json_bytes
    out += struct.pack("<I", len(rgb_jpg)) + rgb_jpg
    out += struct.pack("<I", len(depth_bytes)) + depth_bytes
    out += struct.pack("<I", len(pc_bytes)) + pc_bytes
    return bytes(out)



