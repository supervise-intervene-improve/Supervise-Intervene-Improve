<mujoco model="panda_table_scene">
    <include file="../../generated_panda/sii_panda_model_soft_gripper.xml"/>


    <include file="../../generated_boxes/generated_ycb_textured_boxes.xml"/>
    <include file="../../generated_cups/generated_cups_via_stl_4.xml"/>


    <!-- <option timestep="0.001" integrator="implicitfast"/> -->
    <option timestep="0.001"
        solver="Newton"
        cone="elliptic"
        impratio="4">
        <!-- Match the base scene's contact model while retaining fast-view rendering. -->
        <flag multiccd="enable"/>
    </option>

    <default>
        <geom solimp="0.95 0.99 0.001 0.5 2"
                solref="0.01 1"
                condim="4"
                friction="1.0 0.01 0.001"/>

        <default class="table_leg">
            <geom type="box" size="0.03 0.03 0.2" material="wood_leg"/>
        </default>

        <default class="cell">
            <geom type="box" rgba="0.0 0.0 0.0 1"/>
        </default>

    </default>

    <visual>
        <global offwidth="640" offheight="480"/>
        <headlight ambient="0.6 0.6 0.6" diffuse="0.4 0.4 0.4" specular="0.0 0.0 0.0"/>
        <map znear="0.01" zfar="3"/>
    </visual>

    <asset>
        <!-- This is for SKYBOX -->
        <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="32" height="512"/>
        <!-- This is for GROUND -->
        <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
        <material name="grid" texture="grid" texrepeat="2 2" texuniform="true" reflectance=".2"/>
        <!-- This is for TABLE -->
        <material name="wood_top" rgba="0.6 0.4 0.3 1"/>
        <material name="wood_leg" rgba="0.4 0.25 0.15 1"/>
    </asset> 


    <worldbody>
        <!-- This is for GROUND -->
        <!-- <geom name="floor" type="plane" material="grid" size="2 2 0.1"/> -->
                <!-- This is for GROUND -->
        <!-- <geom name="floor" type="plane" material="grid" size="2 2 0.1"/> -->
        <geom name="floor" type="plane" rgba="0 0 0 1" size="2 2 0.1"/>

        <!-- Back wall -->
        <geom name="back_wall" class="cell"
            pos="-0.20 0 0.8"
            size="0.02 1.2 0.8"
            contype="0" conaffinity="0"/>

        <!-- Left wall -->
        <geom name="left_wall" class="cell"
            pos="0.75 -0.9 0.8"
            size="1.0 0.02 0.8"
            contype="0" conaffinity="0"/>

        <!-- Right wall -->
        <geom name="right_wall" class="cell"
            pos="0.75 0.9 0.8"
            size="1.0 0.02 0.8"
            contype="0" conaffinity="0"/>

        <!-- This is for TABLE -->
        <body name="table" pos="0.6 0 0.2">
            <geom name="table_top" type="box" size="0.35 0.45 0.02" material="wood_top"/>

            <geom name="table_leg_1" class="table_leg" pos="0.28 0.38 -0.2"  />
            <geom name="table_leg_2" class="table_leg" pos="0.28 -0.38 -0.2" />
            <geom name="table_leg_3" class="table_leg" pos="-0.28 0.38 -0.2" />
            <geom name="table_leg_4" class="table_leg" pos="-0.28 -0.38 -0.2"/>
        </body>

        <!-- This is for LIGHT -->
        <light name="main_light" pos="0 0 5.0" dir="0 0 -1"
            castshadow="false"
            diffuse="1 1 1" specular="0.2 0.2 0.2"/>

        <!-- This is for CAMERAS -->
        <camera name="top"   pos="0.6 0 1.2" euler="0 0 -1.5708"/>
        <camera name="front" pos="1.5 0 0.8" xyaxes="0.000 -1.000 0.000 0.542 0.000 -0.841"/>
        <camera name="right" pos="1.1  0.55 0.6" xyaxes="-0.740 0.673 0.000 -0.306 -0.337 0.890"/>
        <camera name="left"  pos="1.1 -0.55 0.6" xyaxes="0.740 0.673 -0.000 -0.306 0.337 0.890"/>

        <camera name="VIS_RIGHT" pos="0.6 +0.75 0.5" xyaxes="-1.000 -0.000 0.000 0.000 -0.316 0.949"/>
        <camera name="VIS_LEFT"  pos="0.6 -0.75 0.5" xyaxes="+1.000 -0.000 0.000 0.000 0.316 0.949"/>
    </worldbody>
</mujoco>
